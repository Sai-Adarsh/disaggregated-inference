function(reject pattern)
    execute_process(COMMAND "${PROGRAM}" ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
    if(NOT result STREQUAL "1" OR NOT stderr MATCHES "${pattern}")
        message(FATAL_ERROR "Unexpected result ${result} for ${ARGN}:\n${stdout}\n${stderr}")
    endif()
endfunction()

reject("usage:")
reject("expected tcp or rdma" serve udp 127.0.0.1 0)
reject("numeric argument outside" serve tcp 127.0.0.1 70000)
reject("numeric argument outside" serve-loop tcp 127.0.0.1 0 2x)
reject("numeric argument outside" serve-loop tcp 127.0.0.1 0 2 cpu 0)
reject("invalid mode or argument count" unknown tcp 127.0.0.1 1234)
reject("expected cpu or cuda" serve tcp 127.0.0.1 0 unknown)
reject("expected an IPv4 address" serve tcp localhost 0)
string(REPEAT "x" 8193 too_long)
reject("prompt must contain" prefill tcp 127.0.0.1 1 "${too_long}" 4)
if(NOT CUDA_ENABLED)
    reject("ENABLE_CUDA" serve tcp 127.0.0.1 0 cuda)
endif()
if(NOT RDMA_ENABLED)
    reject("ENABLE_RDMA" serve rdma 127.0.0.1 0)
endif()
